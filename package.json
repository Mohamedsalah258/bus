{
  "name": "bsu-bus-api",
  "version": "0.14.0",
  "description": "BSU transport backend foundation",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node dist/src/main.js",
    "start:dev": "node --watch dist/src/main.js",
    "db:migrate": "node dist/scripts/migrate.js",
    "admin:create": "node dist/scripts/bootstrap-admin.js",
    "seed:legacy-routes": "node dist/scripts/seed-legacy-routes.js",
    "test": "npm run build && node --test \"dist/test/unit/**/*.spec.js\" \"dist/test/e2e/**/*.spec.js\"",
    "test:unit": "npm run build && node --test \"dist/test/unit/**/*.spec.js\"",
    "test:e2e": "npm run build && node --test \"dist/test/e2e/**/*.spec.js\"",
    "test:integration": "npm run build && node --test --test-concurrency=1 \"dist/test/integration/**/*.integration.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:export": "npm run build && node dist/scripts/export-openapi.js",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohamedsalah258/bus.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Mohamedsalah258/bus/issues"
  },
  "homepage": "https://github.com/Mohamedsalah258/bus#readme",
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.6",
    "helmet": "8.3.0",
    "nodemailer": "10.0.10",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.1.2",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
