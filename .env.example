NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://bus:local-development-only@localhost:5432/bus
POSTGRES_PASSWORD=local-development-only
# Generate locally with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Encrypts two-factor secrets. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it invalidates every enrolled authenticator.
MFA_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
# Only for the explicit bootstrap command; remove after use. Never commit .env.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Number of trusted reverse proxies in front of the API (0 = direct). Never "true".
TRUST_PROXY_HOPS=0

# Email (BL-16). For local development, `docker compose up -d mail` starts
# Mailpit: SMTP on 1025, inbox UI on http://localhost:8025.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="BSU Bus <no-reply@bsu.example>"
MAIL_POLL_INTERVAL_MS=5000
# Optional: only these domains may register, e.g. bsu.edu.eg
ALLOWED_EMAIL_DOMAINS=
